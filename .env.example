# Reference only: copy the values needed for your intended environment.
# Keep actual credentials in ignored .env.local or Vercel environment settings.
# Start with npm run setup:local and npm run dev:review for isolated UI review.

NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# No messages are sent while disabled. Enable only after verifying the sender.
EMAIL_DELIVERY_MODE=disabled
# SMTP uses the supplied Gmail address and Google App Password (server only).
EMAIL_PROVIDER=smtp
EMAIL=
EMAIL_APP_PASSWORD=
EMAIL_REPLY_TO=
# Optional overrides; Gmail defaults to smtp.gmail.com on port 465.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
RESEND_API_KEY=
RESEND_FROM_EMAIL=VacayNanny <noreply@vacaynanny.net>
RESEND_REPLY_TO_EMAIL=hello@vacaynanny.net

# setup:local generates this locally. Configure a separate value on Vercel.
CRON_SECRET=

# Unprefixed credentials are ALWAYS test mode. PROD_ credentials are ALWAYS live.
# Defaults to prod on Vercel Production and uat elsewhere; set explicitly per deployment.
PAYSTACK_MODE=uat
# The Kenyan merchant account must enable card and mobile_money channels.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
# Recommended timestamped signing secret (whsec_...). Empty uses legacy signatures.
PAYSTACK_WEBHOOK_SECRET=
PROD_PAYSTACK_SECRET_KEY=
PROD_PAYSTACK_PUBLIC_KEY=
PROD_PAYSTACK_WEBHOOK_SECRET=
# Set NEXT_PUBLIC_SITE_URL to the current deployment's origin. Hosted callbacks
# use /payments/return/uat or /payments/return/prod; webhooks use
# /api/payments/webhook/uat or /api/payments/webhook/prod.

# Final blank PDF's private nanny-documents path, without the bucket prefix.
# Example: agreements/vacaynanny-nanny-agreement.pdf
NANNY_AGREEMENT_STORAGE_PATH=

# Stable server-only key for encrypted notification bodies and private enquiry links.
# Set before production and preserve it while queued jobs/private enquiry links exist.
NOTIFICATION_ENCRYPTION_KEY=

# Read-only independent operations checks. Separate from the worker CRON_SECRET.
MONITOR_SECRET=
# Backup key: 32 random bytes represented as 64 hex characters; escrow outside Git.
BACKUP_ENCRYPTION_KEY=
# The actual production notification key, escrowed inside encrypted backup archives.
BACKUP_APP_ENCRYPTION_KEY=
